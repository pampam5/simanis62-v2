# Environment Configuration
# Copy this file to .env and update with your actual values

# Application
APP_NAME=SIMANIS62 V2
ENVIRONMENT=development
DEBUG=true

# Server
API_HOST=127.0.0.1
API_PORT=8000

# Database
DATABASE_PATH=C:\ProgramData\Simanis62\simanis62.db

# Security
SECRET_KEY=your-secret-key-here-change-this-in-production
SESSION_TIMEOUT_HOURS=2

# Logging
LOG_LEVEL=INFO
LOG_DIR=D:\simanis62-v2\logs

# GlitchTip (Self-hosted Sentry)
GLITCHTIP_DSN=
GLITCHTIP_ENVIRONMENT=development

# School Information (for reports)
SCHOOL_NAME=Nama Sekolah Anda
SCHOOL_ADDRESS=Alamat Sekolah
SCHOOL_PROVINCE=Provinsi
SCHOOL_CITY=Kota/Kabupaten
