    <!-- RELATIONSHIPS -->

    <!-- Location <-> Asset -->
    <mxCell id="rel_loc_asset" value="1" style="endArrow=diamondThin;endFill=0;endSize=24;html=1;" edge="1" parent="1" source="Location" target="Asset">
      <mxGeometry width="160" relative="1" as="geometry">
        <mxPoint x="600" y="160" as="sourcePoint"/>
        <mxPoint x="410" y="240" as="targetPoint"/>
        <Array as="points">
          <mxPoint x="410" y="135"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="lbl_loc_asset" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="rel_loc_asset">
