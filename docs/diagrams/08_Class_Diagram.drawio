      <mxGeometry y="26" width="180" height="84" as="geometry"/>
    </mxCell>

    <!-- CLASS: Asset -->
    <mxCell id="Asset" value="Asset" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;html=1;" vertex="1" parent="1">
      <mxGeometry x="300" y="240" width="220" height="200" as="geometry"/>
    </mxCell>
    <mxCell id="AssetAttrs" value="+ id: int [PK]&#xa;+ location_id: int [FK]&#xa;+ name: str&#xa;+ code: str&#xa;+ category: str&#xa;+ condition: Enum(Good, Bad)&#xa;+ purchase_date: date&#xa;+ purchase_value: float&#xa;+ status: Enum(Active, Mutasi)&#xa;+ is_deleted: bool" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="Asset">
