      <mxGeometry x="0.8" relative="1" as="geometry">
        <mxPoint y="-10" as="offset"/>
      </mxGeometry>
    </mxCell>

    <!-- Mutation -> Location (Source) -->
    <mxCell id="rel_mut_loc_src" value="src_id" style="endArrow=open;html=1;endSize=12;startArrow=none;startFill=0;dashed=1;" edge="1" parent="1" source="Mutation" target="Location">
