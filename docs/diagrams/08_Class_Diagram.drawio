      <mxGeometry x="40" y="80" width="180" height="130" as="geometry"/>
    </mxCell>
    <mxCell id="UserAttrs" value="+ id: int [PK]&#xa;+ username: str&#xa;+ email: str&#xa;+ password_hash: str&#xa;+ role: Enum(Admin, Staff)&#xa;+ created_at: datetime" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="User">
