      <mxGeometry relative="1" as="geometry">
        <mxPoint x="250" y="320" as="sourcePoint"/>
        <mxPoint x="90" y="320" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    
    <!-- EXPORT TO EXCEL -->
    <mxCell id="export-label" value="EXPORT TO EXCEL (Format BPAD DKI Jakarta)" style="text;fontSize=12;fontStyle=1;align=left;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
      <mxGeometry x="40" y="360" width="320" height="25" as="geometry"/>
    </mxCell>
    
    <mxCell id="msg8" value="9: klik tombol 'Ekspor ke Excel'" style="endArrow=classic;" edge="1" parent="1">
