        <mxPoint x="760" y="100" as="sourcePoint"/>
        <mxPoint x="760" y="800" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    
    <!-- VIEW KIB REPORT -->
    <mxCell id="view-label" value="VIEW KIB REPORT (Preview)" style="text;fontSize=12;fontStyle=1;align=left;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
      <mxGeometry x="40" y="120" width="200" height="25" as="geometry"/>
    </mxCell>
    
    <!-- Messages -->
    <mxCell id="msg1" value="1: pilih kategori KIB (A/B/C/D/E/F)" style="endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="90" y="160" as="sourcePoint"/>
        <mxPoint x="250" y="160" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    
    <mxCell id="msg2" value="2: pilih filter (tahun, kondisi, ruangan)" style="endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="90" y="180" as="sourcePoint"/>
        <mxPoint x="250" y="180" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    
    <mxCell id="msg3" value="3: GET /api/v1/kib/{kategori}?filters" style="endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="250" y="200" as="sourcePoint"/>
        <mxPoint x="420" y="200" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    
    <mxCell id="msg4" value="4: SELECT aset JOIN kib_x WHERE kategori &amp; filters" style="endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="420" y="220" as="sourcePoint"/>
        <mxPoint x="590" y="220" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    
    <mxCell id="ret4" value="5: data aset (max 1000 rows)" style="endArrow=open;dashed=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="590" y="240" as="sourcePoint"/>
        <mxPoint x="420" y="240" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    
    <mxCell id="msg5" value="6: hitung summary (total aset, total nilai)" style="endArrow=classic;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="420" y="260" as="sourcePoint"/>
        <mxPoint x="420" y="280" as="targetPoint"/>
        <Array as="points">
          <mxPoint x="470" y="260"/>
          <mxPoint x="470" y="280"/>
        </Array>
      </mxGeometry>
    </mxCell>
    
    <mxCell id="ret6" value="7: 200 OK + data KIB + summary" style="endArrow=open;dashed=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="420" y="300" as="sourcePoint"/>
        <mxPoint x="250" y="300" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    
