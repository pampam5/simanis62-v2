        <mxPoint x="250" y="420" as="sourcePoint"/>
        <mxPoint x="420" y="420" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    
    <mxCell id="msg10" value="11: validasi permission (Admin/Kepsek)" style="endArrow=classic;" edge="1" parent="1">
