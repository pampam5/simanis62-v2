<mxGraphModel>
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    
    <!-- Title -->
    <mxCell id="title" value="SEQUENCE DIAGRAM - GENERATE LAPORAN KIB" style="text;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
      <mxGeometry x="180" y="10" width="440" height="30" as="geometry"/>
    </mxCell>
    
    <!-- Lifeline Boxes -->
    <mxCell id="user-box" value="User&#xa;(Admin/Kepsek)" style="rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=center;" vertex="1" parent="1">
      <mxGeometry x="40" y="60" width="100" height="40" as="geometry"/>
    </mxCell>
    
    <mxCell id="wpf-box" value="WPF Client" style="rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;align=center;" vertex="1" parent="1">
      <mxGeometry x="200" y="60" width="100" height="40" as="geometry"/>
    </mxCell>
    
    <mxCell id="api-box" value="FastAPI Server" style="rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;align=center;" vertex="1" parent="1">
      <mxGeometry x="360" y="60" width="120" height="40" as="geometry"/>
    </mxCell>
    
    <mxCell id="db-box" value="SQLite DB" style="rounded=0;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;align=center;" vertex="1" parent="1">
