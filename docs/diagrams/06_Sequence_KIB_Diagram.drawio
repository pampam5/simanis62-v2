    </mxCell>
    
    <mxCell id="excel-box" value="Excel Generator" style="rounded=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;align=center;" vertex="1" parent="1">
      <mxGeometry x="700" y="60" width="120" height="40" as="geometry"/>
    </mxCell>
    
    <!-- Lifeline Dashed Lines -->
    <mxCell id="user-line" value="" style="endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="90" y="100" as="sourcePoint"/>
        <mxPoint x="90" y="800" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    
    <mxCell id="wpf-line" value="" style="endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="250" y="100" as="sourcePoint"/>
        <mxPoint x="250" y="800" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    
    <mxCell id="api-line" value="" style="endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry">
        <mxPoint x="420" y="100" as="sourcePoint"/>
        <mxPoint x="420" y="800" as="targetPoint"/>
      </mxGeometry>
    </mxCell>
    
    <mxCell id="db-line" value="" style="endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
