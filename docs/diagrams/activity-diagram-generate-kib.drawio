<mxGraphModel>
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    
    <!-- TITLE -->
    <mxCell id="title" value="Activity Diagram: Proses Generate Laporan KIB" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="200" y="10" width="400" height="30" as="geometry"/>
    </mxCell>
    
    <!-- SWIMLANE: Admin/Kepala Sekolah -->
    <mxCell id="swimlane" value="Admin Sekolah / Kepala Sekolah" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
      <mxGeometry x="40" y="50" width="720" height="580" as="geometry"/>
    </mxCell>
    
    <!-- INITIAL NODE -->
    <mxCell id="initial" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="swimlane">
      <mxGeometry x="350" y="20" width="30" height="30" as="geometry"/>
    </mxCell>
    
    <!-- ACTIVITY: Buka Menu Laporan KIB -->
    <mxCell id="act_menu" value="Buka Menu Laporan KIB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="swimlane">
      <mxGeometry x="280" y="70" width="170" height="45" as="geometry"/>
    </mxCell>
    
    <!-- DECISION: Pilih Jenis KIB -->
    <mxCell id="dec_jenis" value="Pilih&#xa;Jenis KIB" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="swimlane">
      <mxGeometry x="325" y="135" width="80" height="60" as="geometry"/>
    </mxCell>
    
    <!-- KIB Options (Simplified as Merge into one path) -->
    <mxCell id="act_kib_a" value="KIB A&#xa;(Tanah)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="swimlane">
      <mxGeometry x="55" y="140" width="80" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="act_kib_b" value="KIB B&#xa;(Peralatan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="swimlane">
      <mxGeometry x="145" y="140" width="80" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="act_kib_c" value="KIB C&#xa;(Gedung)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="swimlane">
      <mxGeometry x="505" y="140" width="80" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="act_kib_def" value="KIB D/E/F&#xa;(Lainnya)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="swimlane">
      <mxGeometry x="595" y="140" width="80" height="50" as="geometry"/>
    </mxCell>
    
    <!-- MERGE after KIB selection -->
    <mxCell id="merge1" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#000000;" vertex="1" parent="swimlane">
      <mxGeometry x="355" y="215" width="20" height="20" as="geometry"/>
    </mxCell>
    
    <!-- ACTIVITY: Query Database -->
    <mxCell id="act_query" value="Query Database&#xa;(Ambil data aset sesuai golongan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="swimlane">
      <mxGeometry x="260" y="255" width="210" height="50" as="geometry"/>
    </mxCell>
    
    <!-- DECISION: Data Ada? -->
    <mxCell id="dec_data" value="Data&#xa;Ada?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="swimlane">
      <mxGeometry x="325" y="325" width="80" height="60" as="geometry"/>
    </mxCell>
    
    <!-- ACTIVITY: Tampilkan Pesan Kosong -->
    <mxCell id="act_kosong" value="Tampilkan Pesan:&#xa;Data Tidak Ditemukan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="swimlane">
      <mxGeometry x="500" y="332" width="160" height="45" as="geometry"/>
    </mxCell>
    
    <!-- ACTIVITY: Generate Template Laporan -->
    <mxCell id="act_generate" value="Generate Template Laporan&#xa;(Format sesuai Permendagri 19/2016)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="swimlane">
      <mxGeometry x="235" y="405" width="260" height="50" as="geometry"/>
    </mxCell>
    
    <!-- ACTIVITY: Preview Laporan -->
    <mxCell id="act_preview" value="Preview Laporan di Layar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="swimlane">
      <mxGeometry x="280" y="475" width="170" height="45" as="geometry"/>
    </mxCell>
    
    <!-- DECISION: Ekspor? -->
    <mxCell id="dec_export" value="Ekspor?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="swimlane">
      <mxGeometry x="325" y="540" width="80" height="55" as="geometry"/>
    </mxCell>
    
    <!-- ACTIVITY: Ekspor Excel -->
    <mxCell id="act_excel" value="Ekspor ke Excel (.xlsx)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="swimlane">
      <mxGeometry x="460" y="540" width="150" height="45" as="geometry"/>
    </mxCell>
    
    <!-- FINAL NODES -->
    <mxCell id="final1" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="swimlane">
      <mxGeometry x="660" y="340" width="30" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="final2" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="swimlane">
      <mxGeometry x="220" y="552" width="30" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="final3" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="swimlane">
      <mxGeometry x="650" y="547" width="30" height="30" as="geometry"/>
    </mxCell>
    
    <!-- FLOWS -->
    <!-- Initial -> Menu -->
    <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="swimlane" source="initial" target="act_menu">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- Menu -> Decision Jenis -->
    <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="swimlane" source="act_menu" target="dec_jenis">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- Decision -> KIB options -->
    <mxCell id="f3a" value="[A]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="swimlane" source="dec_jenis" target="act_kib_a">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="f3b" value="[B]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="swimlane" source="dec_jenis" target="act_kib_b">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="f3c" value="[C]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="swimlane" source="dec_jenis" target="act_kib_c">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="f3d" value="[D/E/F]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="swimlane" source="dec_jenis" target="act_kib_def">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- KIB options -> Merge -->
    <mxCell id="f4a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="swimlane" source="act_kib_a" target="merge1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="95" y="225"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="f4b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="swimlane" source="act_kib_b" target="merge1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="185" y="225"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="f4c" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="swimlane" source="act_kib_c" target="merge1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="545" y="225"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="f4d" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="swimlane" source="act_kib_def" target="merge1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="635" y="225"/>
        </Array>
      </mxGeometry>
    </mxCell>
    
    <!-- Merge -> Query -->
    <mxCell id="f5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="swimlane" source="merge1" target="act_query">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- Query -> Decision Data -->
    <mxCell id="f6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="swimlane" source="act_query" target="dec_data">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- Decision Data -> Kosong [Tidak] -->
    <mxCell id="f7" value="[Tidak]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="swimlane" source="dec_data" target="act_kosong">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- Kosong -> Final1 -->
    <mxCell id="f8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="swimlane" source="act_kosong" target="final1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- Decision Data -> Generate [Ya] -->
    <mxCell id="f9" value="[Ya]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="swimlane" source="dec_data" target="act_generate">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- Generate -> Preview -->
    <mxCell id="f10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="swimlane" source="act_generate" target="act_preview">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- Preview -> Decision Export -->
    <mxCell id="f11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="swimlane" source="act_preview" target="dec_export">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- Decision Export -> Final2 [Tidak] -->
    <mxCell id="f12" value="[Tidak]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="swimlane" source="dec_export" target="final2">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- Decision Export -> Excel [Ya] -->
    <mxCell id="f13" value="[Ya]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="swimlane" source="dec_export" target="act_excel">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    
    <!-- Excel -> Final3 -->
    <mxCell id="f14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="swimlane" source="act_excel" target="final3">
