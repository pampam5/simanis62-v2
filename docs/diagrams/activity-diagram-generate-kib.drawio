    <!-- NOTE -->
    <mxCell id="note" value="Catatan: Format Laporan KIB mengikuti standar Permendagri Nomor 19 Tahun 2016" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fontColor=#333333;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;size=20;align=left;spacingLeft=5;" vertex="1" parent="1">
      <mxGeometry x="460" y="650" width="300" height="50" as="geometry"/>
