<UserControl x:Class="Simanis62.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Simanis62.Converters"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Login Card -->
        <materialDesign:Card Grid.Column="1"
                             VerticalAlignment="Center"
                             Padding="48"
                             MinWidth="400"
                             materialDesign:ElevationAssist.Elevation="Dp4">
            <StackPanel>
                <!-- Logo/Title -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,32">
                    <materialDesign:PackIcon Kind="School"
                                             Width="64" Height="64"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             HorizontalAlignment="Center"/>
                    <TextBlock Text="SIMANIS62"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                    <TextBlock Text="Sistem Manajemen Aset Sekolah"
                               FontSize="14"
                               Foreground="Gray"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Error Message -->
                <Border Background="#FFEBEE"
                        CornerRadius="4"
                        Padding="12"
                        Margin="0,0,0,16"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertCircle"
                                                 Foreground="{StaticResource ErrorBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource ErrorBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Username -->
                <TextBox materialDesign:HintAssist.Hint="Username"
                         materialDesign:HintAssist.IsFloating="True"
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16"
                         IsEnabled="{Binding IsNotBusy}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding LoginCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <!-- Password -->
                <PasswordBox materialDesign:HintAssist.Hint="Password"
                             materialDesign:HintAssist.IsFloating="True"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             materialDesign:PasswordBoxAssist.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,24"
                             IsEnabled="{Binding IsNotBusy}">
                    <PasswordBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding LoginCommand}"/>
                    </PasswordBox.InputBindings>
                </PasswordBox>

                <!-- Login Button -->
                <Button Content="MASUK"
                        Command="{Binding LoginCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="48"
                        IsEnabled="{Binding IsNotBusy}"/>

                <!-- Loading Indicator -->
                <ProgressBar IsIndeterminate="True"
                             Margin="0,16,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

                <!-- Version Info -->
                <TextBlock Text="Versi 2.0.0"
                           FontSize="11"
                           Foreground="Gray"
                           HorizontalAlignment="Center"
                           Margin="0,24,0,0"/>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
