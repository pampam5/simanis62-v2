<UserControl x:Class="Simanis62.Views.MutationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Simanis62.Converters"
             Background="{StaticResource BackgroundBrush}"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StatusToColorConverter x:Key="StatusToColor"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="24,24,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Mutasi Aset" Style="{StaticResource PageTitleStyle}"/>
            <Button Grid.Column="1"
                    Command="{Binding CreateMutationCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Visibility="{Binding CanCreate, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="SwapHorizontal" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Buat Mutasi"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Tabs -->
        <materialDesign:Card Grid.Row="1" Margin="24,0,24,16" Padding="8">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Semua"
                             IsChecked="{Binding ShowAll}"
                             Command="{Binding FilterCommand}"
                             CommandParameter=""
                             Style="{StaticResource MaterialDesignTabRadioButtonLeft}"/>
                <RadioButton Content="Dalam Proses"
                             IsChecked="{Binding ShowPending}"
                             Command="{Binding FilterCommand}"
                             CommandParameter="Dalam_Proses"
                             Style="{StaticResource MaterialDesignTabRadioButtonCenter}"/>
                <RadioButton Content="Selesai"
                             IsChecked="{Binding ShowCompleted}"
                             Command="{Binding FilterCommand}"
                             CommandParameter="Selesai"
                             Style="{StaticResource MaterialDesignTabRadioButtonCenter}"/>
                <RadioButton Content="Dibatalkan"
                             IsChecked="{Binding ShowCancelled}"
                             Command="{Binding FilterCommand}"
                             CommandParameter="Dibatalkan"
                             Style="{StaticResource MaterialDesignTabRadioButtonRight}"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- Content -->
        <Grid Grid.Row="2" Margin="24,0,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Mutation List -->
            <materialDesign:Card Grid.Column="0" Margin="0,0,16,0" Padding="0">
                <DataGrid ItemsSource="{Binding Mutations}"
                          SelectedItem="{Binding SelectedMutation}"
                          Style="{StaticResource ModernDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tanggal" Binding="{Binding TanggalMutasi, StringFormat=dd/MM/yyyy}" Width="100"/>
                        <DataGridTextColumn Header="Aset" Binding="{Binding NamaAset}" Width="*"/>
                        <DataGridTextColumn Header="Dari" Binding="{Binding RuanganAsal}" Width="120"/>
                        <DataGridTextColumn Header="Ke" Binding="{Binding RuanganTujuan}" Width="120"/>
                        <DataGridTemplateColumn Header="Status" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <materialDesign:Chip Content="{Binding Status}"
                                                         Background="{Binding Status, Converter={StaticResource StatusToColor}}"
                                                         Foreground="White"
                                                         FontSize="11"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>

            <!-- Detail Panel -->
            <materialDesign:Card Grid.Column="1" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Detail Mutasi" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,16"/>

                        <!-- No Selection -->
                        <TextBlock Text="Pilih mutasi untuk melihat detail"
                                   Foreground="Gray"
                                   HorizontalAlignment="Center"
                                   Margin="0,32"
                                   Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVis}}"/>

                        <!-- Detail Content -->
                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <!-- Asset Info -->
                            <TextBlock Text="Informasi Aset" FontWeight="Medium" Margin="0,0,0,8"/>
                            <Border Background="#F5F5F5" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock>
                                        <Run Text="Nama: " FontWeight="Medium"/>
                                        <Run Text="{Binding SelectedMutation.NamaAset}"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,4,0,0">
                                        <Run Text="Kode: " FontWeight="Medium"/>
                                        <Run Text="{Binding SelectedMutation.KodeAset}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Mutation Info -->
                            <TextBlock Text="Informasi Mutasi" FontWeight="Medium" Margin="0,0,0,8"/>
                            <Border Background="#F5F5F5" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="DoorOpen" Width="24" Height="24" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding SelectedMutation.RuanganAsal}"
                                                       HorizontalAlignment="Center"
                                                       FontWeight="Medium"
                                                       Margin="0,4,0,0"/>
                                            <TextBlock Text="Asal" Foreground="Gray" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <materialDesign:PackIcon Grid.Column="1"
                                                                 Kind="ArrowRight"
                                                                 Width="32" Height="32"
                                                                 Foreground="{StaticResource PrimaryBrush}"
                                                                 VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="DoorOpen" Width="24" Height="24" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding SelectedMutation.RuanganTujuan}"
                                                       HorizontalAlignment="Center"
                                                       FontWeight="Medium"
                                                       Margin="0,4,0,0"/>
                                            <TextBlock Text="Tujuan" Foreground="Gray" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <Separator Margin="0,12"/>
                                    <TextBlock>
                                        <Run Text="Tanggal: " FontWeight="Medium"/>
                                        <Run Text="{Binding SelectedMutation.TanggalMutasi, StringFormat=dd MMMM yyyy}"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,4,0,0">
                                        <Run Text="Kondisi: " FontWeight="Medium"/>
                                        <Run Text="{Binding SelectedMutation.KondisiSaatMutasi}"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,4,0,0">
                                        <Run Text="Oleh: " FontWeight="Medium"/>
                                        <Run Text="{Binding SelectedMutation.NamaUser}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Alasan -->
                            <TextBlock Text="Alasan Mutasi" FontWeight="Medium" Margin="0,0,0,8"/>
                            <Border Background="#F5F5F5" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                                <TextBlock Text="{Binding SelectedMutation.Alasan}" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Visibility="{Binding CanModify, Converter={StaticResource BoolToVis}}">
                                <Button Content="Batalkan"
                                        Command="{Binding CancelMutationCommand}"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Margin="0,0,8,0"
                                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}"/>
                                <Button Content="Selesaikan"
                                        Command="{Binding CompleteMutationCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Visibility="{Binding CanComplete, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>
        </Grid>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3" Style="{StaticResource LoadingOverlayStyle}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="100"
                             Style="{StaticResource MaterialDesignCircularProgressBar}"/>
                <TextBlock Text="Memuat data..." Margin="0,16,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
