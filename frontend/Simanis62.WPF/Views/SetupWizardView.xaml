<UserControl x:Class="Simanis62.Views.SetupWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Simanis62.Converters"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Progress Indicator -->
        <Border Grid.Row="0" Background="White" Padding="24,16">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="{Binding CurrentStep, StringFormat='Langkah {0} dari 3'}"
                           FontSize="14"
                           Foreground="Gray"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>
                
                <!-- Step Indicators -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- Step 1 -->
                    <Ellipse Width="12" Height="12"
                             Fill="{StaticResource PrimaryBrush}"/>
                    <Rectangle Width="60" Height="2" VerticalAlignment="Center"
                               Fill="{Binding IsStep1, Converter={StaticResource BoolToVis}, ConverterParameter=Gray|Primary}">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Fill" Value="{StaticResource PrimaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep1}" Value="True">
                                        <Setter Property="Fill" Value="LightGray"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                    
                    <!-- Step 2 -->
                    <Ellipse Width="12" Height="12">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource PrimaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep1}" Value="True">
                                        <Setter Property="Fill" Value="LightGray"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <Rectangle Width="60" Height="2" VerticalAlignment="Center">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Fill" Value="{StaticResource PrimaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep3}" Value="False">
                                        <Setter Property="Fill" Value="LightGray"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                    
                    <!-- Step 3 -->
                    <Ellipse Width="12" Height="12">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource PrimaryBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep3}" Value="False">
                                        <Setter Property="Fill" Value="LightGray"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Step 1: Welcome -->
            <materialDesign:Card Grid.Column="1"
                                 VerticalAlignment="Center"
                                 Padding="48"
                                 MinWidth="500"
                                 MaxWidth="600"
                                 materialDesign:ElevationAssist.Elevation="Dp4"
                                 Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <materialDesign:PackIcon Kind="School"
                                             Width="80" Height="80"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="SIMANIS62 V2"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0"/>
                    
                    <TextBlock Text="Sistem Manajemen Aset Sekolah"
                               FontSize="16"
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,24"/>
                    
                    <Separator Margin="0,0,0,24"/>
                    
                    <TextBlock TextWrapping="Wrap"
                               TextAlignment="Center"
                               FontSize="14"
                               LineHeight="24"
                               Margin="0,0,0,16">
                        <Run Text="Selamat datang di SIMANIS62!"/>
                        <LineBreak/><LineBreak/>
                        <Run Text="Aplikasi ini akan membantu Anda mengelola aset sekolah sesuai dengan format BPAD DKI Jakarta dan regulasi Permendagri 19/2016."/>
                        <LineBreak/><LineBreak/>
                        <Run Text="Untuk memulai, Anda perlu membuat akun Administrator yang akan digunakan untuk mengelola aplikasi."/>
                    </TextBlock>
                    
                    <Button Content="LANJUTKAN"
                            Command="{Binding NextStepCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="48"
                            Margin="0,24,0,0"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Step 2: Create Admin -->
            <materialDesign:Card Grid.Column="1"
                                 VerticalAlignment="Center"
                                 Padding="48"
                                 MinWidth="500"
                                 MaxWidth="600"
                                 materialDesign:ElevationAssist.Elevation="Dp4"
                                 Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                        <materialDesign:PackIcon Kind="AccountPlus"
                                                 Width="48" Height="48"
                                                 Foreground="{StaticResource PrimaryBrush}"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Buat Administrator"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </StackPanel>
                    
                    <TextBlock Text="Buat akun administrator untuk mengelola aplikasi."
                               FontSize="14"
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24"/>

                    <!-- Error Message -->
                    <Border Background="#FFEBEE"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,16"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircle"
                                                     Foreground="{StaticResource ErrorBrush}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{StaticResource ErrorBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Username -->
                    <TextBox materialDesign:HintAssist.Hint="Username"
                             materialDesign:HintAssist.IsFloating="True"
                             materialDesign:HintAssist.HelperText="Min 5 karakter, huruf, angka, underscore"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,8"
                             IsEnabled="{Binding IsNotBusy}"/>
                    <TextBlock Text="{Binding UsernameError}"
                               Foreground="{StaticResource ErrorBrush}"
                               FontSize="12"
                               Margin="0,0,0,8"
                               Visibility="{Binding UsernameError, Converter={StaticResource BoolToVis}}"/>

                    <!-- Password -->
                    <PasswordBox materialDesign:HintAssist.Hint="Password"
                                 materialDesign:HintAssist.IsFloating="True"
                                 materialDesign:HintAssist.HelperText="Min 8 karakter"
                                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                 materialDesign:PasswordBoxAssist.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,8,0,8"
                                 IsEnabled="{Binding IsNotBusy}"/>
                    <TextBlock Text="{Binding PasswordError}"
                               Foreground="{StaticResource ErrorBrush}"
                               FontSize="12"
                               Margin="0,0,0,8"
                               Visibility="{Binding PasswordError, Converter={StaticResource BoolToVis}}"/>

                    <!-- Confirm Password -->
                    <PasswordBox materialDesign:HintAssist.Hint="Konfirmasi Password"
                                 materialDesign:HintAssist.IsFloating="True"
                                 materialDesign:HintAssist.HelperText="Masukkan password yang sama"
                                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                 materialDesign:PasswordBoxAssist.Password="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,8,0,8"
                                 IsEnabled="{Binding IsNotBusy}"/>
                    <TextBlock Text="{Binding ConfirmPasswordError}"
                               Foreground="{StaticResource ErrorBrush}"
                               FontSize="12"
                               Margin="0,0,0,8"
                               Visibility="{Binding ConfirmPasswordError, Converter={StaticResource BoolToVis}}"/>

                    <!-- Nama Lengkap -->
                    <TextBox materialDesign:HintAssist.Hint="Nama Lengkap"
                             materialDesign:HintAssist.IsFloating="True"
                             materialDesign:HintAssist.HelperText="Nama yang akan ditampilkan di aplikasi"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding NamaLengkap, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,8,0,8"
                             IsEnabled="{Binding IsNotBusy}"/>
                    <TextBlock Text="{Binding NamaLengkapError}"
                               Foreground="{StaticResource ErrorBrush}"
                               FontSize="12"
                               Margin="0,0,0,16"
                               Visibility="{Binding NamaLengkapError, Converter={StaticResource BoolToVis}}"/>

                    <!-- Loading Indicator -->
                    <ProgressBar IsIndeterminate="True"
                                 Margin="0,0,0,16"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

                    <!-- Buttons -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Column="0"
                                Content="KEMBALI"
                                Command="{Binding PreviousStepCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="48"/>
                        
                        <Button Grid.Column="2"
                                Content="BUAT ADMINISTRATOR"
                                Command="{Binding CreateAdminCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="48"/>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Step 3: Success -->
            <materialDesign:Card Grid.Column="1"
                                 VerticalAlignment="Center"
                                 Padding="48"
                                 MinWidth="500"
                                 MaxWidth="600"
                                 materialDesign:ElevationAssist.Elevation="Dp4"
                                 Visibility="{Binding IsStep3, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <materialDesign:PackIcon Kind="CheckCircle"
                                             Width="80" Height="80"
                                             Foreground="#4CAF50"
                                             HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="Setup Berhasil!"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#4CAF50"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,24"/>
                    
                    <Separator Margin="0,0,0,24"/>
                    
                    <TextBlock Text="Akun administrator telah berhasil dibuat."
                               FontSize="14"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"/>
                    
                    <!-- Admin Info Card -->
                    <Border Background="#F5F5F5"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,24">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Username:" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding CreatedAdmin.Username}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Nama:" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding CreatedAdmin.NamaLengkap}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Role:" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="Administrator"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <TextBlock TextWrapping="Wrap"
                               TextAlignment="Center"
                               FontSize="14"
                               Foreground="Gray"
                               Margin="0,0,0,24">
                        Anda sekarang dapat login menggunakan akun ini untuk mulai mengelola aset sekolah.
                    </TextBlock>
                    
                    <Button Content="MULAI SEKARANG"
                            Command="{Binding StartApplicationCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="48"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
