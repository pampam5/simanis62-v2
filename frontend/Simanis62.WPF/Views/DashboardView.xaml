<UserControl x:Class="Simanis62.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Simanis62.Converters"
             Background="{StaticResource BackgroundBrush}"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel>
                <!-- Page Header -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Dashboard" Style="{StaticResource PageTitleStyle}"/>
                    <Button Grid.Column="1"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="{Binding IsNotBusy}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Refresh"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Summary Cards -->
                <UniformGrid Rows="1" Margin="0,0,0,24">
                    <!-- Total Aset -->
                    <materialDesign:Card Style="{StaticResource StatCardStyle}" Cursor="Hand"
                                         MouseLeftButtonUp="OnAssetCardClick">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Package"
                                                         Width="32" Height="32"
                                                         Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="Total Aset"
                                           FontSize="14"
                                           Foreground="Gray"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding TotalAset}"
                                       FontSize="36"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Total Nilai -->
                    <materialDesign:Card Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CurrencyUsd"
                                                         Width="32" Height="32"
                                                         Foreground="{StaticResource SecondaryBrush}"/>
                                <TextBlock Text="Total Nilai"
                                           FontSize="14"
                                           Foreground="Gray"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding TotalNilai}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource SecondaryBrush}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Total Ruangan -->
                    <materialDesign:Card Style="{StaticResource StatCardStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DoorOpen"
                                                         Width="32" Height="32"
                                                         Foreground="#7B1FA2"/>
                                <TextBlock Text="Total Ruangan"
                                           FontSize="14"
                                           Foreground="Gray"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding TotalRuangan}"
                                       FontSize="36"
                                       FontWeight="Bold"
                                       Foreground="#7B1FA2"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Mutasi Pending -->
                    <materialDesign:Card Style="{StaticResource StatCardStyle}" Cursor="Hand"
                                         MouseLeftButtonUp="OnMutationCardClick">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="SwapHorizontal"
                                                         Width="32" Height="32"
                                                         Foreground="{StaticResource WarningBrush}"/>
                                <TextBlock Text="Mutasi Pending"
                                           FontSize="14"
                                           Foreground="Gray"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding MutasiPending}"
                                       FontSize="36"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource WarningBrush}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>
                </UniformGrid>

                <!-- KIB Categories -->
                <TextBlock Text="Aset per Kategori KIB" Style="{StaticResource SectionTitleStyle}"/>
                <UniformGrid Rows="2" Columns="3" Margin="0,0,0,24">
                    <materialDesign:Card Style="{StaticResource DashboardCardStyle}" Cursor="Hand"
                                         MouseLeftButtonUp="OnKibAClick">
                        <StackPanel>
                            <TextBlock Text="KIB A" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="Tanah" FontSize="12" Foreground="Gray"/>
                            <TextBlock Text="{Binding AsetKibA}" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Style="{StaticResource DashboardCardStyle}" Cursor="Hand"
                                         MouseLeftButtonUp="OnKibBClick">
                        <StackPanel>
                            <TextBlock Text="KIB B" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="Peralatan dan Mesin" FontSize="12" Foreground="Gray"/>
                            <TextBlock Text="{Binding AsetKibB}" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Style="{StaticResource DashboardCardStyle}" Cursor="Hand"
                                         MouseLeftButtonUp="OnKibCClick">
                        <StackPanel>
                            <TextBlock Text="KIB C" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="Gedung dan Bangunan" FontSize="12" Foreground="Gray"/>
                            <TextBlock Text="{Binding AsetKibC}" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Style="{StaticResource DashboardCardStyle}" Cursor="Hand"
                                         MouseLeftButtonUp="OnKibDClick">
                        <StackPanel>
                            <TextBlock Text="KIB D" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="Jalan, Irigasi, Jaringan" FontSize="12" Foreground="Gray"/>
                            <TextBlock Text="{Binding AsetKibD}" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Style="{StaticResource DashboardCardStyle}" Cursor="Hand"
                                         MouseLeftButtonUp="OnKibEClick">
                        <StackPanel>
                            <TextBlock Text="KIB E" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="Aset Tetap Lainnya" FontSize="12" Foreground="Gray"/>
                            <TextBlock Text="{Binding AsetKibE}" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Style="{StaticResource DashboardCardStyle}" Cursor="Hand"
                                         MouseLeftButtonUp="OnKibFClick">
                        <StackPanel>
                            <TextBlock Text="KIB F" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="Konstruksi Dalam Pengerjaan" FontSize="12" Foreground="Gray"/>
                            <TextBlock Text="{Binding AsetKibF}" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>
                </UniformGrid>

                <!-- Status Summary -->
                <TextBlock Text="Aset per Status" Style="{StaticResource SectionTitleStyle}"/>
                <UniformGrid Rows="1" Columns="3">
                    <materialDesign:Card Style="{StaticResource DashboardCardStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Aktif" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AsetAktif}" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Style="{StaticResource DashboardCardStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12" Fill="{StaticResource ErrorBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Rusak" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AsetRusak}" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Style="{StaticResource DashboardCardStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="12" Height="12" Fill="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Mutasi" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AsetMutasi}" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </materialDesign:Card>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Grid Style="{StaticResource LoadingOverlayStyle}">
            <ProgressBar IsIndeterminate="True"
                         Width="100"
                         Style="{StaticResource MaterialDesignCircularProgressBar}"/>
        </Grid>
    </Grid>
</UserControl>
