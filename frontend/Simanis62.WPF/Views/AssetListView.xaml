<UserControl x:Class="Simanis62.Views.AssetListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Simanis62.Converters"
             Background="{StaticResource BackgroundBrush}"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="24,24,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Daftar Aset" Style="{StaticResource PageTitleStyle}"/>
            <Button Grid.Column="1"
                    Command="{Binding CreateAssetCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Tambah Aset"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Search & Filters -->
        <materialDesign:Card Grid.Row="1" Margin="24,0,24,16" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <TextBox Grid.Column="0"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Cari nama barang, kode barang..."
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,8,0">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <!-- Kategori Filter -->
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding KategoriOptions}"
                          SelectedItem="{Binding SelectedKategori}"
                          materialDesign:HintAssist.Hint="Kategori KIB"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,8,0"/>

                <!-- Status Filter -->
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatus}"
                          materialDesign:HintAssist.Hint="Status"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,8,0"/>

                <!-- Ruangan Filter -->
                <ComboBox Grid.Column="3"
                          ItemsSource="{Binding Rooms}"
                          SelectedItem="{Binding SelectedRuangan}"
                          DisplayMemberPath="NamaRuangan"
                          materialDesign:HintAssist.Hint="Ruangan"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,8,0"/>

                <!-- Search Button -->
                <Button Grid.Column="4"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Magnify" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Cari"/>
                    </StackPanel>
                </Button>

                <!-- Clear Button -->
                <Button Grid.Column="5"
                        Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Reset Filter">
                    <materialDesign:PackIcon Kind="FilterRemove"/>
                </Button>
            </Grid>
        </materialDesign:Card>

        <!-- Data Grid -->
        <materialDesign:Card Grid.Row="2" Margin="24,0,24,16" Padding="0">
            <DataGrid ItemsSource="{Binding Assets}"
                      SelectedItem="{Binding SelectedAsset}"
                      Style="{StaticResource ModernDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="No. Register" Binding="{Binding NomorRegister}" Width="100"/>
                    <DataGridTextColumn Header="Kode Barang" Binding="{Binding KodeBarang}" Width="140"/>
                    <DataGridTextColumn Header="Nama Barang" Binding="{Binding NamaBarang}" Width="*"/>
                    <DataGridTextColumn Header="KIB" Binding="{Binding KategoriKib}" Width="60"/>
                    <DataGridTextColumn Header="Ruangan" Binding="{Binding NamaRuangan}" Width="120"/>
                    <DataGridTextColumn Header="Tahun" Binding="{Binding TahunPerolehan}" Width="70"/>
                    <DataGridTextColumn Header="Harga" Binding="{Binding Harga, StringFormat=N0}" Width="120"/>
                    <DataGridTextColumn Header="Kondisi" Binding="{Binding Kondisi}" Width="90"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                    <DataGridTemplateColumn Header="Aksi" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding DataContext.ViewAssetDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Lihat Detail"
                                            Width="32" Height="32">
                                        <materialDesign:PackIcon Kind="Eye" Width="18" Height="18"/>
                                    </Button>
                                    <Button Command="{Binding DataContext.EditAssetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Edit"
                                            Width="32" Height="32"
                                            Visibility="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVis}}">
                                        <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18" Foreground="{StaticResource PrimaryBrush}"/>
                                    </Button>
                                    <Button Command="{Binding DataContext.DeleteAssetCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            ToolTip="Hapus"
                                            Width="32" Height="32"
                                            Visibility="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVis}}">
                                        <materialDesign:PackIcon Kind="Delete" Width="18" Height="18" Foreground="{StaticResource ErrorBrush}"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>

        <!-- Pagination -->
        <materialDesign:Card Grid.Row="3" Margin="24,0,24,24" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center">
                    <Run Text="Menampilkan"/>
                    <Run Text="{Binding Assets.Count, Mode=OneWay}"/>
                    <Run Text="dari"/>
                    <Run Text="{Binding TotalItems, Mode=OneWay}"/>
                    <Run Text="aset"/>
                </TextBlock>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding PreviousPageCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Halaman Sebelumnya">
                        <materialDesign:PackIcon Kind="ChevronLeft"/>
                    </Button>
                    <TextBlock VerticalAlignment="Center" Margin="16,0">
                        <Run Text="Halaman"/>
                        <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                        <Run Text="dari"/>
                        <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                    </TextBlock>
                    <Button Command="{Binding NextPageCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            ToolTip="Halaman Berikutnya">
                        <materialDesign:PackIcon Kind="ChevronRight"/>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">
                    <Run Text="{Binding PageSize, Mode=OneWay}"/>
                    <Run Text="item per halaman"/>
                </TextBlock>
            </Grid>
        </materialDesign:Card>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="4" Style="{StaticResource LoadingOverlayStyle}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="100"
                             Style="{StaticResource MaterialDesignCircularProgressBar}"/>
                <TextBlock Text="Memuat data..." Margin="0,16,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
